{
  "name": "pixel-sea-window",
  "version": "1.0.0",
  "description": "像素风海景窗：一个挂机在桌面右上角的像素海景小窗",
  "main": "main.js",
  "scripts": {
    "test": "node tests/scene.cjs && node tests/audio.cjs",
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.pixel-sea-window",
    "productName": "PixelSeaWindow",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png"
    }
  }
}
